rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    // Product and vendor images store
    match /products/{vendorUid}/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated() && request.auth.uid == vendorUid
        && request.resource.size < 5 * 1024 * 1024 // max 5MB
        && request.resource.contentType.matches('image/.*');
    }

    match /vendors/{vendorUid}/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated() && request.auth.uid == vendorUid
        && request.resource.size < 2 * 1024 * 1024 // max 2MB
        && request.resource.contentType.matches('image/.*');
    }
  }
}
