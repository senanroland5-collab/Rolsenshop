rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Vendors collection
    match /vendors/{vendorId} {
      allow read: if true; // Public storefront resolution
      allow create: if isAuthenticated() && request.auth.uid == vendorId;
      allow update, delete: if isOwner(vendorId);
    }

    // Products collection
    match /products/{productId} {
      allow read: if true; // Public catalog viewing
      allow create, update, delete: if isAuthenticated() &&
        request.resource.data.vendorUid == request.auth.uid;
    }

    // Orders collection
    match /orders/{orderId} {
      allow create: if true; // Customers creating orders via WhatsApp form
      allow read, update, delete: if isAuthenticated() &&
        resource.data.vendorUid == request.auth.uid;
    }
  }
}
